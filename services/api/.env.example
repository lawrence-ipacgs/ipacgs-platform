# Local development only. Copy to .env and fill in — .env is gitignored.
# In dev/test/prod, these come from Container Apps env vars + Key Vault
# references, not a .env file — see infra/README.md § Secrets.

ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://ipacgsadmin:localpassword@localhost:5432/ipacgs
KEY_VAULT_URI=
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
ENTRA_API_APP_ID=
LOG_LEVEL=INFO
